@page "/community"

<PageTitle>Crafty — Community</PageTitle>

<div class="crafty-community p-3">

    <!-- HERO -->
    <section class="community-hero">
        <div class="container py-5">
            <div class="community-hero-content">

                <div class="eyebrow">
                    <span></span>
                    CRAFTY COMMUNITY
                </div>

                <h1 class="hero-title">
                    Built together.<br />
                    <span>Shared with everyone.</span>
                </h1>

                <p class="hero-description">
                    Discover worlds, mods, projects, and people building
                    things with Crafty. Explore what the community is
                    creating and share something of your own.
                </p>

                <div class="hero-meta mt-4">
                    <div>
                        <i>●</i> Community projects
                    </div>

                    <div>
                        <i>●</i> Mods &amp; worlds
                    </div>

                    <div>
                        <i>●</i> Open development
                    </div>
                </div>

            </div>
        </div>
    </section>


    <section class="community-nav border-section mt-5 mb-5">
        <div class="container">

            <div class="community-nav-grid">

                <a href="#projects" class="community-nav-item">
                    <span class="community-nav-number">01</span>

                    <div>
                        <strong>Projects</strong>
                        <span>See what people are building</span>
                    </div>

                    <i>→</i>
                </a>

                <a href="#showcase" class="community-nav-item ">
                    <span class="community-nav-number">02</span>

                    <div>
                        <strong>Showcase</strong>
                        <span>Explore creations made with Crafty</span>
                    </div>

                    <i>→</i>
                </a>

                <a href="#mods" class="community-nav-item">
                    <span class="community-nav-number">03</span>

                    <div>
                        <strong>Mods</strong>
                        <span>Extend Crafty your way</span>
                    </div>

                    <i>→</i>
                </a>

                <a href="#developers" class="community-nav-item">
                    <span class="community-nav-number">04</span>

                    <div>
                        <strong>Developers</strong>
                        <span>Build for the ecosystem</span>
                    </div>

                    <i>→</i>
                </a>

            </div>

        </div>
    </section>


    <!-- PROJECTS -->
    <section class="section">
        <div class="container">

            <div class="section-intro">
                <div class="eyebrow">
                    <span></span>
                    DISCOVER
                </div>

                <h2 class="section-title mt-3">
                    Community <span>projects.</span>
                </h2>

                <p class="section-description">
                    See what players and developers are building with Crafty.
                    From experimental mods to massive worlds and developer
                    tools, the community is part of the ecosystem.
                </p>
            </div>


            <div class="project-grid mt-5 mb-5">

                <article class="project-item">
                    <div class="project-preview">
                        <div class="preview-label">PROJECT</div>
                    </div>

                    <div class="project-content">
                        <div class="project-number">01</div>

                        <div class="project-type">
                            MOD
                        </div>

                        <h3>Example Project</h3>

                        <p>
                            A community-built project for Crafty.
                        </p>

                        <div class="project-footer">
                            <span>Creator</span>
                            <span>→</span>
                        </div>
                    </div>
                </article>


                <article class="project-item">
                    <div class="project-preview">
                        <div class="preview-label">WORLD</div>
                    </div>

                    <div class="project-content">
                        <div class="project-number">02</div>

                        <div class="project-type">
                            WORLD
                        </div>

                        <h3>Example World</h3>

                        <p>
                            A world created and shared by the community.
                        </p>

                        <div class="project-footer">
                            <span>Creator</span>
                            <span>→</span>
                        </div>
                    </div>
                </article>


                <article class="project-item">
                    <div class="project-preview">
                        <div class="preview-label">TOOL</div>
                    </div>

                    <div class="project-content">
                        <div class="project-number">03</div>

                        <div class="project-type">
                            TOOL
                        </div>

                        <h3>Example Tool</h3>

                        <p>
                            A tool built around the Crafty ecosystem.
                        </p>

                        <div class="project-footer">
                            <span>Creator</span>
                            <span>→</span>
                        </div>
                    </div>
                </article>

            </div>

        </div>
    </section>


    <!-- SHOWCASE -->
    <section class="section showcase-section mt-5">

        <div class="container">

            <div class="eyebrow">
                <span></span>
                SHOWCASE
            </div>

            <h2 class="section-title mt-3">
                Made with <span>Crafty.</span>
            </h2>

            <p class="section-description">
                Builds, worlds, experiments, and creations from the
                Crafty community.
            </p>


            <div class="showcase-grid">

                <article class="showcase-item showcase-large">
                    <div class="showcase-placeholder">
                        <span>COMMUNITY BUILD</span>
                    </div>

                    <div class="showcase-caption">
                        <div>
                            <strong>Something incredible</strong>
                            <span>by Creator</span>
                        </div>

                        <span>→</span>
                    </div>
                </article>


                <article class="showcase-item">
                    <div class="showcase-placeholder">
                        <span>WORLD</span>
                    </div>

                    <div class="showcase-caption">
                        <div>
                            <strong>Community World</strong>
                            <span>by Creator</span>
                        </div>

                        <span>→</span>
                    </div>
                </article>


                <article class="showcase-item">
                    <div class="showcase-placeholder">
                        <span>MOD</span>
                    </div>

                    <div class="showcase-caption">
                        <div>
                            <strong>Community Mod</strong>
                            <span>by Creator</span>
                        </div>

                        <span>→</span>
                    </div>
                </article>

            </div>

        </div>

    </section>


    <!-- COMMUNITY AREAS -->
    <section class="section mt-5">

        <div class="container">

            <div class="eyebrow">
                <span></span>
                GET INVOLVED
            </div>

            <h2 class="section-title mt-3">
                Find your <span>place.</span>
            </h2>


            <div class="community-grid mt-5">

                <a href="#" class="community-item">
                    <div class="community-number">01</div>

                    <div class="community-icon">↗</div>

                    <h3>Discussions</h3>

                    <p>
                        Talk about Crafty, share ideas, ask questions,
                        and meet other members.
                    </p>

                    <span class="community-arrow">→</span>
                </a>


                <a href="#" class="community-item">
                    <div class="community-number">02</div>

                    <div class="community-icon">◇</div>

                    <h3>Mods</h3>

                    <p>
                        Discover community-made mods and extend
                        Crafty in new directions.
                    </p>

                    <span class="community-arrow">→</span>
                </a>


                <a href="#" class="community-item">
                    <div class="community-number">03</div>

                    <div class="community-icon">□</div>

                    <h3>Worlds</h3>

                    <p>
                        Share your worlds and explore creations
                        from other players.
                    </p>

                    <span class="community-arrow">→</span>
                </a>


                <a href="#" class="community-item">
                    <div class="community-number">04</div>

                    <div class="community-icon">&lt;/&gt;</div>

                    <h3>Developers</h3>

                    <p>
                        Build mods, tools, libraries, servers,
                        and anything else for Crafty.
                    </p>

                    <span class="community-arrow">→</span>
                </a>

            </div>

        </div>

    </section>


    <!-- DEVELOPER BANNER -->
    <section class="section mt-5">

        <div class="container">

            <div class="development-banner">

                <div>
                    <div class="eyebrow">
                        <span></span>
                        BUILD FOR CRAFTY
                    </div>

                    <h2 class="mt-3">
                        Build something of your own.
                    </h2>

                    <p>
                        Crafty is designed to be extended. Use the SDK,
                        MDK, and developer tools to create mods, tools,
                        servers, and new experiences.
                    </p>
                </div>

                <a href="/docs" class="community-button">
                    Read the Docs →
                </a>

            </div>

        </div>

    </section>


    <!-- FINAL CTA -->
    <section class="section final-section mt-5">

        <div class="container">

            <div class="eyebrow">
                <span></span>
                THE COMMUNITY
            </div>

            <h2 class="final-title mt-4">
                Build it.<br />
                <span>Share it.</span>
            </h2>

            <p class="section-description">
                Crafty is more than an engine or a game.
                It's an ecosystem built by the people using it.
            </p>

            <div class="final-actions mt-4">
                <a href="/downloads" class="community-button">
                    Get Crafty
                </a>

                <a href="/docs" class="community-button secondary">
                    Start Building
                </a>
            </div>

        </div>

    </section>

</div>


<style>

    .crafty-community {
        background: #0b0f0d;
        color: #fff;
    }


    /* HERO */

    .community-hero {
        min-height: 78vh;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,.07);
        background: radial-gradient( circle at 70% 30%, rgba(25,135,84,.09), transparent 35% );
    }

    .community-hero-content {
        max-width: 1000px;
    }


    /* PROJECTS */

    .project-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid rgba(255,255,255,.08);
        border-left: 1px solid rgba(255,255,255,.08);
    }

    .project-item {
        min-width: 0;
        border-right: 1px solid rgba(255,255,255,.08);
        border-bottom: 1px solid rgba(255,255,255,.08);
        transition: background .2s ease;
    }

        .project-item:hover {
            background: rgba(25,135,84,.035);
        }

    .project-preview {
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 1px solid rgba(255,255,255,.08);
        background: linear-gradient( 135deg, rgba(255,255,255,.025), rgba(25,135,84,.025) );
    }

    .preview-label {
        color: rgba(255,255,255,.2);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .15em;
    }

    .project-content {
        padding: 1.5rem;
    }

    .project-number {
        color: rgba(255,255,255,.2);
        font-size: .7rem;
        font-weight: 700;
    }

    .project-type {
        margin-top: 1.5rem;
        color: #35a85f;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .12em;
    }

    .project-content h3 {
        margin-top: .5rem;
        font-size: 1.3rem;
        font-weight: 750;
    }

    .project-content p {
        margin: .6rem 0 2rem;
        color: rgba(255,255,255,.4);
        font-size: .9rem;
        line-height: 1.7;
    }

    .project-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 1px solid rgba(255,255,255,.07);
        color: rgba(255,255,255,.35);
        font-size: .75rem;
    }

        .project-footer span:last-child {
            color: #35a85f;
        }


    .community-nav {
        padding: 0;
    }

    .community-nav-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-left: 1px solid rgba(255,255,255,.07);
    }

    .community-nav-item {
        min-height: 120px;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        border-right: 1px solid rgba(255,255,255,.07);
        color: inherit;
        text-decoration: none;
        transition: background .2s ease;
    }

        .community-nav-item:hover {
            background: rgba(25,135,84,.035);
        }

    .community-nav-number {
        align-self: flex-start;
        color: rgba(255,255,255,.2);
        font-size: .65rem;
        font-weight: 700;
    }

    .community-nav-item div {
        flex: 1;
    }

    .community-nav-item strong {
        display: block;
        font-size: .9rem;
        font-weight: 700;
    }

    .community-nav-item span:not(.community-nav-number) {
        display: block;
        margin-top: .35rem;
        color: rgba(255,255,255,.35);
        font-size: .72rem;
        line-height: 1.5;
    }

    .community-nav-item i {
        color: #35a85f;
        font-style: normal;
        font-size: .9rem;
    }

    @@media (max-width: 767px) {
        .community-nav-grid {
            grid-template-columns: 1fr;
        }

        .community-nav-item {
            min-height: 90px;
        }
    }

    /* SHOWCASE */

    .showcase-section {
        background: rgba(255,255,255,.012);
    }

    .showcase-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.08);
    }

    .showcase-item {
        position: relative;
        min-height: 280px;
        overflow: hidden;
        background: #0e1310;
    }

    .showcase-large {
        grid-row: span 2;
        min-height: 560px;
    }

    .showcase-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient( circle at center, rgba(25,135,84,.07), transparent 60% );
        color: rgba(255,255,255,.18);
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .15em;
    }

    .showcase-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding: 2rem;
        background: linear-gradient( transparent, rgba(0,0,0,.8) );
    }

        .showcase-caption strong,
        .showcase-caption span {
            display: block;
        }

        .showcase-caption strong {
            font-size: 1rem;
        }

        .showcase-caption span {
            margin-top: .3rem;
            color: rgba(255,255,255,.4);
            font-size: .72rem;
        }

        .showcase-caption > span {
            color: #35a85f;
            font-size: 1rem;
        }


    /* COMMUNITY AREAS */

    .community-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-top: 1px solid rgba(255,255,255,.08);
        border-left: 1px solid rgba(255,255,255,.08);
    }

    .community-item {
        position: relative;
        min-height: 260px;
        padding: 2rem;
        border-right: 1px solid rgba(255,255,255,.08);
        border-bottom: 1px solid rgba(255,255,255,.08);
        color: inherit;
        text-decoration: none;
        transition: background .2s ease;
    }

        .community-item:hover {
            background: rgba(25,135,84,.035);
        }

    .community-number {
        color: rgba(255,255,255,.2);
        font-size: .7rem;
        font-weight: 700;
    }

    .community-icon {
        margin: 2rem 0 1.5rem;
        color: #35a85f;
        font-family: Consolas, monospace;
        font-size: 1.5rem;
    }

    .community-item h3 {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .community-item p {
        max-width: 500px;
        margin: .5rem 0 0;
        color: rgba(255,255,255,.4);
        font-size: .9rem;
        line-height: 1.7;
    }

    .community-arrow {
        position: absolute;
        right: 2rem;
        bottom: 2rem;
        color: #35a85f;
    }


    /* BUTTONS */

    .community-button {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        padding: .9rem 1.25rem;
        border: 1px solid rgba(53,168,95,.5);
        color: #fff;
        text-decoration: none;
        font-size: .8rem;
        font-weight: 700;
        transition: background .2s ease, border-color .2s ease;
    }

        .community-button:hover {
            background: rgba(53,168,95,.08);
            border-color: #35a85f;
            color: #fff;
        }

        .community-button.secondary {
            border-color: rgba(255,255,255,.12);
            color: rgba(255,255,255,.7);
        }


    /* FINAL */

    .final-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }


    /* MOBILE */

    @@media (max-width: 767px) {

        .community-hero {
            min-height: auto;
        }

        .section {
            padding: 5rem 0;
        }

        .project-grid {
            grid-template-columns: 1fr;
        }

        .showcase-grid {
            grid-template-columns: 1fr;
        }

        .showcase-large {
            grid-row: auto;
            min-height: 350px;
        }

        .showcase-item {
            min-height: 280px;
        }

        .community-grid {
            grid-template-columns: 1fr;
        }

        .development-banner {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>
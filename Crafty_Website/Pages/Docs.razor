@page "/docs"
@page "/docs/{PageSlug}"
@using Crafty_Website.Components.Documentation

<PageTitle>Crafty — @CurrentTitle</PageTitle>

<div class="docs-page">
    <SideBar />
    <main class="docs-main">
        <div class="docs-content">
            <div class="docs-breadcrumb">
                <a href="/docs/overview">Crafty Documentation</a>
                <i class="bi bi-chevron-right"></i>
                <span>@CurrentTitle</span>
            </div>
            @switch (NormalizedSlug)
            {
                case "overview": <Overview /> break;

                case "architecture": <Architecture /> break;

                case "startup": <Startup /> break;

                case "ecs": <ECS /> break;

                case "world": <World /> break;

                case "generation": <Generation /> break;

                case "rendering": <Rendering /> break;

                case "ui": <UI /> break;

                case "sdk": <SDKOverview /> break;

                case "content": <ContentMods /> break;

                case "generation-mods": <GenerationMods /> break;

                case "lifecycle": <ModLifecycle /> break;

                case "build": <BuildRun /> break;

                case "api": <APIRef /> break;

                default: <NotFoundDocs /> break;
            }
        </div>
    </main>
</div>

@code {
    [Parameter] public string? PageSlug { get; set; }
    private string NormalizedSlug => string.IsNullOrWhiteSpace(PageSlug) ? "overview" : PageSlug.ToLowerInvariant();
    private string CurrentTitle => NormalizedSlug switch
    {
        "overview" => "Documentation Overview",
        "architecture" => "Architecture",
        "startup" => "Startup & Game Loop",
        "ecs" => "Entity Component System",
        "world" => "World & Chunk Storage",
        "generation" => "World Generation & Jobs",
        "rendering" => "Rendering Pipeline",
        "ui" => "UI & HUD",
        "sdk" => "SDK Overview",
        "content" => "Blocks & Items",
        "generation-mods" => "Chunk Generation API",
        "lifecycle" => "Mod Loading Status",
        "build" => "Build & Run",
        "api" => "API Reference & Known Gaps",
        _ => "Page Not Found"
    };
}
